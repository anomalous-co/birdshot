query I
SELECT birdshot_commit_config();
----
ok

query I
SELECT birdshot_authenticate('wsess', 'wtok', '');
----
true

query I
SELECT birdshot_authenticate('isess', 'itok', '');
----
true

query I
SELECT birdshot_authenticate('usess', 'utok', '');
----
true

query I
SELECT birdshot_authenticate('fsess', 'ftok', '');
----
true

query I
SELECT birdshot_authenticate('rsess', 'rtok', '');
----
true

query I
SELECT birdshot_authenticate('ksess', 'ktok', '');
----
true

# ---- WRITE umbrella back-compat: a legacy `write` grant still covers ALL DML ----

query I
SELECT birdshot_authorize('wsess', 'SELECT c1 FROM main.dt');
----
true

query I
SELECT birdshot_authorize('wsess', 'INSERT INTO main.dt VALUES (1, 2)');
----
true

query I
SELECT birdshot_authorize('wsess', 'UPDATE main.dt SET c1 = 1 WHERE c2 = 2');
----
true

query I
SELECT birdshot_authorize('wsess', 'DELETE FROM main.dt WHERE c1 = 1');
----
true

# TRUNCATE maps to DELETE (v1.5.3: parses to an unconditioned DeleteStatement).
# The WRITE umbrella covers DELETE + READ, so TRUNCATE is allowed here.
query I
SELECT birdshot_authorize('wsess', 'TRUNCATE main.dt');
----
true

# ---- split DML: an INSERT-only grant allows INSERT, denies the rest ---------

query I
SELECT birdshot_authorize('isess', 'INSERT INTO main.dt VALUES (1, 2)');
----
true

# INSERT-only cannot SELECT.
query I
SELECT birdshot_authorize('isess', 'SELECT c1 FROM main.dt');
----
false

# INSERT-only cannot UPDATE (fine-grained caps cover only themselves).
query I
SELECT birdshot_authorize('isess', 'UPDATE main.dt SET c1 = 1 WHERE c2 = 2');
----
false

# INSERT-only cannot DELETE.
query I
SELECT birdshot_authorize('isess', 'DELETE FROM main.dt WHERE c1 = 1');
----
false

# INSERT ... SELECT FROM self needs {INSERT, READ}; read is missing -> deny.
query I
SELECT birdshot_authorize('isess', 'INSERT INTO main.dt SELECT c1, c2 FROM main.dt');
----
false

# ---- LOCKED: UPDATE/DELETE do NOT imply READ -------------------------------
# uonly holds UPDATE but not READ; UPDATE...WHERE requires BOTH -> deny.

query I
SELECT birdshot_authorize('usess', 'UPDATE main.dt SET c1 = 1 WHERE c2 = 2');
----
false

# ---- fine-grained full-DML role: each cap works on its own action ----------

query I
SELECT birdshot_authorize('fsess', 'INSERT INTO main.dt VALUES (1, 2)');
----
true

query I
SELECT birdshot_authorize('fsess', 'UPDATE main.dt SET c1 = 1 WHERE c2 = 2');
----
true

query I
SELECT birdshot_authorize('fsess', 'DELETE FROM main.dt WHERE c1 = 1');
----
true

query I
SELECT birdshot_authorize('fsess', 'SELECT c1 FROM main.dt');
----
true

# ---- read-only role: SELECT allowed, writes + TRUNCATE denied --------------

query I
SELECT birdshot_authorize('rsess', 'SELECT c1 FROM main.dt');
----
true

query I
SELECT birdshot_authorize('rsess', 'INSERT INTO main.dt VALUES (1, 2)');
----
false

# TRUNCATE (maps to DELETE, which also scans -> needs DELETE+READ); read-only -> deny.
query I
SELECT birdshot_authorize('rsess', 'TRUNCATE main.dt');
----
false

# ---- object-kind separation (DROP): a table-kind drop grant never satisfies a
# sequence DROP, and vice versa (spec §1c). ----------------------------------

# sequence-kind drop grant on main.sq satisfies DROP SEQUENCE main.sq -> allow.
query I
SELECT birdshot_authorize('ksess', 'DROP SEQUENCE main.sq');
----
true

# ...but NOT a table DROP of the same name (only a sequence-kind grant exists) -> deny.
query I
SELECT birdshot_authorize('ksess', 'DROP TABLE main.sq');
----
false

# table-kind drop grant on main.tb satisfies DROP TABLE main.tb -> allow.
query I
SELECT birdshot_authorize('ksess', 'DROP TABLE main.tb');
----
true

# ...but NOT a sequence DROP of the same name (only a table-kind grant exists) -> deny.
query I
SELECT birdshot_authorize('ksess', 'DROP SEQUENCE main.tb');
----
false

# back-compat (advisor R): TABLE and VIEW are ONE relation class (spec §8a), so the
# legacy table-kind drop grant on main.tb ALSO covers DROP VIEW main.tb. Without the
# TABLE≡VIEW rule in KindMatch this would wrongly deny — a silent regression, since
# every legacy drop/alter grant is table-kind but `DROP VIEW` now carries VIEW kind.
query I
SELECT birdshot_authorize('ksess', 'DROP VIEW main.tb');
----
true

# ...and the separation still holds the other way: main.sq has ONLY a sequence-kind
# drop grant, so DROP VIEW main.sq (VIEW use) is NOT covered -> deny. TABLE≡VIEW does
# not leak into the SEQUENCE class.
query I
SELECT birdshot_authorize('ksess', 'DROP VIEW main.sq');
----
false

# ---- CREATE object types: SEQUENCE / TYPE / MACRO now emit a CREATE cap_use.
# CREATE is schema-scoped (kind TABLE), so the cs.* create grant covers every kind. -

query I
SELECT birdshot_authorize('ksess', 'CREATE SEQUENCE cs.s1');
----
true

query I
SELECT birdshot_authorize('ksess', 'CREATE TYPE cs.ty AS ENUM (''a'', ''b'')');
----
true

query I
SELECT birdshot_authorize('ksess', 'CREATE MACRO cs.m() AS 1');
----
true

# CREATE SEQUENCE in an UNGRANTED schema -> deny.
query I
SELECT birdshot_authorize('ksess', 'CREATE SEQUENCE other.s1');
----
false

# CREATE INDEX stays fail-closed (resource model deferred) -> deny.
query I
SELECT birdshot_authorize('ksess', 'CREATE INDEX ix ON main.tb(c1)');
----
false

# ---- IsProtectedRef: the grant store is unaddressable in BOTH planes --------
# ku holds a WILDCARD read grant (`*`) that RefMatches everything, yet the store
# table is DENIED anyway — protection overrides any grant, for every token.

# bind-walk plane: SELECT of the protected table -> deny (despite wildcard read).
query I
SELECT birdshot_authorize('ksess', 'SELECT * FROM __birdshot_grants');
----
false

# parse-walk plane: DROP of the protected table -> deny (despite the drop grant).
query I
SELECT birdshot_authorize('ksess', 'DROP TABLE __birdshot_grants');
----
false

# DML plane: INSERT into the protected table -> deny.
query I
SELECT birdshot_authorize('ksess', 'INSERT INTO __birdshot_grants VALUES (''x'', ''y'')');
----
false

# ---- Stage B: birdshot_set_grant_store config function ----------------------

# default / explicit memory backend.
query I
SELECT birdshot_set_grant_store('memory', '');
----
memory

# table backend selects the 'table' kind and reserves the protected store catalog.
query I
SELECT birdshot_set_grant_store('table', ':memory:');
----
table

# unknown kind falls back to memory (fail-closed: never half-enable a store).
query I
SELECT birdshot_set_grant_store('bogus', 'x');
----
memory

# a token can NEVER invoke the store config over the wire (birdshot_* denylist).
query I
SELECT birdshot_authorize('ksess', 'SELECT birdshot_set_grant_store(''table'', ''x'')');
----
false

# ==========================================================================
# Native GRANT / REVOKE statement (ParserExtension authoring surface)
# ==========================================================================
#
# `GRANT …` / `REVOKE …` execute as real SQL (no birdshot_* call) and mutate the
# LIVE grant store immediately (direct-to-live, no staging/commit). Self-contained
# config block (appended last so no later commit clobbers these direct-live grants).

query I
SELECT birdshot_reset_config();
----
ok

query I
SELECT birdshot_set_auth('', '', 'dev');
----
ok

query I
SELECT birdshot_add_service_token('gsvc', 'grantee1');
----
ok

# A subject whose id EQUALS an admin role name ("collide"), for the namespace
# isolation test at the end. Committed here (service tokens are staged); the
# collision GRANTs are direct-to-live later so this commit can't clobber them.
query I
SELECT birdshot_add_service_token('collide-tok', 'collide');
----
ok

# A subject with NO explicit roles/grants ("norole"), for the PUBLIC test: a GRANT
# TO PUBLIC must reach it even though it holds nothing. Committed here for the same
# reason (later PUBLIC grants are direct-to-live).
query I
SELECT birdshot_add_service_token('norole-tok', 'norole');
----
ok

query I
SELECT birdshot_commit_config();
----
ok

statement ok
CREATE TABLE main.gtab(id INT, title VARCHAR);

statement ok
CREATE TABLE main.gall(id INT, title VARCHAR);

statement ok
CREATE TABLE main.grole(id INT, title VARCHAR);

query I
SELECT birdshot_authenticate('gsess', 'gsvc', '');
----
true

# ---- GRANT then REVOKE a table privilege (enforcement reflects each) ---------

# Before any grant: default-deny.
query I
SELECT birdshot_authorize('gsess', 'SELECT * FROM main.gtab');
----
false

# Native GRANT executes and emits a status row.
query I
GRANT SELECT ON main.gtab TO grantee1;
----
GRANT

# Grant took effect immediately -> allow.
query I
SELECT birdshot_authorize('gsess', 'SELECT * FROM main.gtab');
----
true

# Native REVOKE removes the exact grant -> back to deny.
query I
REVOKE SELECT ON main.gtab FROM grantee1;
----
REVOKE

query I
SELECT birdshot_authorize('gsess', 'SELECT * FROM main.gtab');
----
false

# ---- ALL PRIVILEGES expands to the object class's full cap set ---------------

query I
GRANT ALL PRIVILEGES ON main.gall TO grantee1;
----
GRANT

# SELECT (read) covered.
query I
SELECT birdshot_authorize('gsess', 'SELECT * FROM main.gall');
----
true

# INSERT (insert) covered by the same ALL PRIVILEGES grant.
query I
SELECT birdshot_authorize('gsess', 'INSERT INTO main.gall VALUES (1, ''x'')');
----
true

# ---- role membership (GRANT <role> TO <subject>) + TO ROLE -------------------

# Grant SELECT to a NAMED role (grantee1 is not a member yet).
query I
GRANT SELECT ON main.grole TO ROLE greaders;
----
GRANT

query I
SELECT birdshot_authorize('gsess', 'SELECT * FROM main.grole');
----
false

# Add grantee1 to the role -> now covered.
query I
GRANT greaders TO grantee1;
----
GRANT

query I
SELECT birdshot_authorize('gsess', 'SELECT * FROM main.grole');
----
true

# Revoke the membership -> deny again.
query I
REVOKE greaders FROM grantee1;
----
REVOKE

query I
SELECT birdshot_authorize('gsess', 'SELECT * FROM main.grole');
----
false

# ---- THE WIRE-DENY SECURITY TEST (mandatory) --------------------------------
#
# An authenticated non-admin session must NEVER be able to grant itself access by
# submitting a GRANT over the authorize path. The parse-walk pre-filter denies the
# EXTENSION_STATEMENT / GRANT-shaped SQL fail-closed BEFORE any bind/plan/execution.

# gtab is currently NOT granted to grantee1 (revoked above). A wire GRANT is denied…
query I
SELECT birdshot_authorize('gsess', 'GRANT SELECT ON main.gtab TO grantee1');
----
false

# …AND it did not take effect: the subsequent SELECT is still denied.
query I
SELECT birdshot_authorize('gsess', 'SELECT * FROM main.gtab');
----
false

# Wire REVOKE is denied too (same gate).
query I
SELECT birdshot_authorize('gsess', 'REVOKE ALL PRIVILEGES ON main.gall FROM grantee1');
----
false

# The wire REVOKE was ineffective: grantee1 still holds ALL PRIVILEGES on gall.
query I
SELECT birdshot_authorize('gsess', 'SELECT * FROM main.gall');
----
true

# ---- fail-closed parse errors (unknown / unenforced privilege; deferred) -----

# Unenforced PG privilege -> hard error (never a silent drop).
statement error
GRANT TRIGGER ON main.gtab TO grantee1;
----
unknown or unenforced privilege

# Typo'd privilege -> hard error.
statement error
GRANT SELCT ON main.gtab TO grantee1;
----
unknown or unenforced privilege

# Empty column list -> clear error (never a silent drop).
statement error
GRANT SELECT () ON main.gtab TO grantee1;
----
empty column list

# CURRENT_USER is an HONEST BLOCKER on this path (no caller identity available);
# the error states the reason (not a generic "unsupported").
statement error
GRANT SELECT ON main.gtab TO CURRENT_USER;
----
needs a caller identity

# REVOKE GRANT OPTION FOR needs the Phase 3b delegation graph -> clear error.
statement error
REVOKE GRANT OPTION FOR SELECT ON main.gtab FROM grantee1;
----
not supported yet

# A column list on a non-relation object is rejected.
statement error
GRANT USAGE (x) ON SEQUENCE main.gseq TO grantee1;
----
column lists apply only to TABLE/VIEW

# Malformed (no grantee) -> error.
statement error
GRANT SELECT ON main.gtab TO;
----
birdshot GRANT

# ---- multi-grantee (TO a, ROLE r) in one statement --------------------------

statement ok
CREATE TABLE main.gmulti(id INT);

# One GRANT to a subject AND a named role at once.
query I
GRANT SELECT ON main.gmulti TO grantee1, ROLE gmrole;
----
GRANT

# The subject grantee (grantee1) is covered.
query I
SELECT birdshot_authorize('gsess', 'SELECT * FROM main.gmulti');
----
true

# ---- subject/role namespace isolation (advisor Finding A) --------------------
# A subject id that happens to equal an admin ROLE name must NOT inherit that
# role's grants. `TO <subject>` stores the grant under a namespaced self-role, so
# subject "collide" and role "collide" live in disjoint keyspaces. Before the fix
# this leaked the role's grant to the subject (privilege escalation).

statement ok
CREATE TABLE main.gsensitive(id INT);

statement ok
CREATE TABLE main.gbenign(id INT);

# Admin grants a SENSITIVE privilege to the ROLE named "collide".
query I
GRANT SELECT ON main.gsensitive TO ROLE collide;
----
GRANT

# A BENIGN privilege is granted to the SUBJECT "collide" (same string as the role).
query I
GRANT SELECT ON main.gbenign TO collide;
----
GRANT

# Authenticate a session for user "collide" (token committed in the setup block).
query I
SELECT birdshot_authenticate('csess', 'collide-tok', '');
----
true

# The subject gets its OWN direct grant (gbenign) -> allow.
query I
SELECT birdshot_authorize('csess', 'SELECT * FROM main.gbenign');
----
true

# But it must NOT inherit ROLE "collide"'s grant (gsensitive) -> deny.
# (Pre-fix this returned true = escalation.)
query I
SELECT birdshot_authorize('csess', 'SELECT * FROM main.gsensitive');
----
false

# ==========================================================================
# Native GRANT / REVOKE — Phase 3a deferred constructs, now BUILT
# ==========================================================================

# ---- Tier 1: COLUMN LISTS (GrantConstraint allow-list) ----------------------
# `GRANT SELECT (c1,c2) ON t` = a read grant on t PLUS a column allow-list {c1,c2}
# enforced by the SAME EnforceBoundConstraints path a pushed constraint uses.

statement ok
CREATE TABLE main.gcol(id INT, title VARCHAR, secret VARCHAR);

query I
GRANT SELECT (id, title) ON main.gcol TO grantee1;
----
GRANT

# Allowed columns -> allow.
query I
SELECT birdshot_authorize('gsess', 'SELECT id, title FROM main.gcol');
----
true

# A non-allowed column -> deny (secret is outside the allow-list).
query I
SELECT birdshot_authorize('gsess', 'SELECT secret FROM main.gcol');
----
false

# A star pulls in secret -> deny.
query I
SELECT birdshot_authorize('gsess', 'SELECT * FROM main.gcol');
----
false

# REVOKE with the column list removes BOTH the base grant and the constraint.
query I
REVOKE SELECT (id, title) ON main.gcol FROM grantee1;
----
REVOKE

# Grant gone -> even an allowed column now denies (no base read grant).
query I
SELECT birdshot_authorize('gsess', 'SELECT id FROM main.gcol');
----
false

# ---- Tier 1: column lists on WRITES (UPDATE target columns) ------------------
# INSERT/UPDATE target columns are charged into read_cols by the bind-walk, so the
# same allow-list restricts which columns a write may touch.

query I
GRANT SELECT ON main.gcol TO grantee1;
----
GRANT

query I
GRANT UPDATE (title) ON main.gcol TO grantee1;
----
GRANT

# UPDATE of an allowed column -> allow.
query I
SELECT birdshot_authorize('gsess', 'UPDATE main.gcol SET title = ''x''');
----
true

# UPDATE of a non-allowed column -> deny (secret outside the allow-list).
query I
SELECT birdshot_authorize('gsess', 'UPDATE main.gcol SET secret = ''x''');
----
false

# ---- Tier 2: ALL TABLES IN SCHEMA -> wildcard <schema>.* --------------------

statement ok
CREATE SCHEMA gtsch;

statement ok
CREATE TABLE gtsch.ta(a INT);

statement ok
CREATE TABLE gtsch.tb(b INT);

query I
GRANT SELECT ON ALL TABLES IN SCHEMA gtsch TO grantee1;
----
GRANT

# The one wildcard grant covers EVERY table in the schema.
query I
SELECT birdshot_authorize('gsess', 'SELECT * FROM gtsch.ta');
----
true

query I
SELECT birdshot_authorize('gsess', 'SELECT * FROM gtsch.tb');
----
true

# The wildcard is catalog-AGNOSTIC by design (`*.gtsch.*`): it matches an EXPLICITLY
# catalog-qualified ref too, via the schema segment. (A plain control-plane `gtsch.*`
# push stays catalog-SENSITIVE and would NOT match this — see RefMatch; that asymmetry
# preserves the compiler's fail-closed cold-cache invariant.)
query I
SELECT birdshot_authorize('gsess', 'SELECT * FROM memory.gtsch.ta');
----
true

# A table in a DIFFERENT schema, with NO grant at all, is not covered by gtsch.* ->
# deny. (Unmasked negative: gnope has no grant/constraint, so this deny can ONLY be
# "gtsch.* did not match" — it would fail if the wildcard ever over-matched.)
statement ok
CREATE TABLE main.gnope(x INT);

query I
SELECT birdshot_authorize('gsess', 'SELECT * FROM main.gnope');
----
false

# ---- Tier 3: PUBLIC reaches every identity (incl. a role-less user) ----------

statement ok
CREATE TABLE main.gpub(id INT);

# Authenticate "norole" — a subject with NO roles/grants at all.
query I
SELECT birdshot_authenticate('nrsess', 'norole-tok', '');
----
true

# Before the PUBLIC grant: default-deny for the role-less user.
query I
SELECT birdshot_authorize('nrsess', 'SELECT * FROM main.gpub');
----
false

query I
GRANT SELECT ON main.gpub TO PUBLIC;
----
GRANT

# PUBLIC reaches the role-less user (the enforcement-hot-path merge).
query I
SELECT birdshot_authorize('nrsess', 'SELECT * FROM main.gpub');
----
true

# …and a user WITH roles too.
query I
SELECT birdshot_authorize('gsess', 'SELECT * FROM main.gpub');
----
true

# Revoking PUBLIC removes it for EVERYONE.
query I
REVOKE SELECT ON main.gpub FROM PUBLIC;
----
REVOKE

query I
SELECT birdshot_authorize('nrsess', 'SELECT * FROM main.gpub');
----
false

query I
SELECT birdshot_authorize('gsess', 'SELECT * FROM main.gpub');
----
false

# ---- Tier 4: WITH GRANT OPTION / GRANTED BY (stored, accepted, no error) -----

statement ok
CREATE TABLE main.gwgo(id INT);

# WITH GRANT OPTION parses + stores; the grant itself still takes effect.
query I
GRANT SELECT ON main.gwgo TO grantee1 WITH GRANT OPTION;
----
GRANT

query I
SELECT birdshot_authorize('gsess', 'SELECT * FROM main.gwgo');
----
true

# GRANTED BY parses + stores; grant takes effect.
query I
GRANT SELECT ON main.gwgo TO grantee1 GRANTED BY someadmin;
----
GRANT

query I
SELECT birdshot_authorize('gsess', 'SELECT * FROM main.gwgo');
----
true

# ---- Tier 5: CASCADE / RESTRICT on REVOKE (accepted; plain scoped revoke) ----

statement ok
CREATE TABLE main.gcasc(id INT);

query I
GRANT SELECT ON main.gcasc TO grantee1;
----
GRANT

query I
REVOKE SELECT ON main.gcasc FROM grantee1 CASCADE;
----
REVOKE

query I
SELECT birdshot_authorize('gsess', 'SELECT * FROM main.gcasc');
----
false

query I
GRANT SELECT ON main.gcasc TO grantee1;
----
GRANT

query I
REVOKE SELECT ON main.gcasc FROM grantee1 RESTRICT;
----
REVOKE

query I
SELECT birdshot_authorize('gsess', 'SELECT * FROM main.gcasc');
----
false

# ---- WIRE-DENY holds for a COLUMN-LIST GRANT (mandatory security re-check) ---
# A wire-submitted column-list GRANT is denied fail-closed AND is ineffective.

statement ok
CREATE TABLE main.gwire(id INT, title VARCHAR);

query I
SELECT birdshot_authorize('gsess', 'GRANT SELECT (id) ON main.gwire TO grantee1');
----
false

# …and it did not take effect: the subsequent SELECT is still denied.
query I
SELECT birdshot_authorize('gsess', 'SELECT id FROM main.gwire');
----
false

# ==========================================================================
# Native DENY / UNDENY — deny-wins ACL (spec DENY), standalone (memory mode)
# ==========================================================================
#
# A use is authorized iff (some GRANT matches) AND (no DENY matches). A DENY beats a
# GRANT regardless of grant specificity (deny-wins-always). DENY is a first-class SQL
# statement stored/hydrated exactly like GRANT; here we exercise the standalone native
# path (gsess = grantee1, still memory mode so no store epoch is required).

statement ok
CREATE SCHEMA sales;

statement ok
CREATE TABLE sales.orders(id INT, amt INT);

statement ok
CREATE TABLE sales.pii(id INT, ssn VARCHAR);

# ---- schema-wide GRANT + table DENY (via ROLE r): allow orders, deny pii ------
# GRANT SELECT ON ALL TABLES IN SCHEMA sales (wildcard *.sales.*) then DENY the pii table.
query I
GRANT SELECT ON ALL TABLES IN SCHEMA sales TO ROLE r;
----
GRANT

query I
DENY SELECT ON sales.pii TO ROLE r;
----
DENY

query I
GRANT r TO grantee1;
----
GRANT

# member of r: allowed on a non-denied table covered by the schema-wide grant…
query I
SELECT birdshot_authorize('gsess', 'SELECT * FROM sales.orders');
----
true

# …but DENIED on sales.pii — the DENY overrides the schema-wide grant (deny-wins).
query I
SELECT birdshot_authorize('gsess', 'SELECT * FROM sales.pii');
----
false

# ---- deny-wins over a MORE-SPECIFIC same-ref grant ---------------------------
# grantee1 gets an EXACT grant on sales.pii; the ROLE-level DENY still wins.
query I
GRANT SELECT ON sales.pii TO grantee1;
----
GRANT

query I
SELECT birdshot_authorize('gsess', 'SELECT * FROM sales.pii');
----
false

# ---- UNDENY restores access (the grants are still present) -------------------
query I
UNDENY SELECT ON sales.pii FROM ROLE r;
----
UNDENY

query I
SELECT birdshot_authorize('gsess', 'SELECT * FROM sales.pii');
----
true

# ---- deny-wins when GRANT and DENY name the SAME grantee directly ------------
statement ok
CREATE TABLE sales.direct(id INT);

query I
GRANT SELECT ON sales.direct TO grantee1;
----
GRANT

query I
SELECT birdshot_authorize('gsess', 'SELECT * FROM sales.direct');
----
true

query I
DENY SELECT ON sales.direct TO grantee1;
----
DENY

# grant present, deny present on the same (grantee, ref) -> DENIED (deny-wins).
query I
SELECT birdshot_authorize('gsess', 'SELECT * FROM sales.direct');
----
false

query I
UNDENY SELECT ON sales.direct FROM grantee1;
----
UNDENY

query I
SELECT birdshot_authorize('gsess', 'SELECT * FROM sales.direct');
----
true

# ---- PARSE-WALK deny-wins (DDL plane): DENY overrides a DROP grant -----------
# birdshot_authorize only CHECKS (never executes), so main.gtab survives every call.
query I
GRANT DROP ON main.gtab TO grantee1;
----
GRANT

query I
SELECT birdshot_authorize('gsess', 'DROP TABLE main.gtab');
----
true

query I
DENY DROP ON main.gtab TO grantee1;
----
DENY

# deny-wins in the PARSE-WALK (DDL) plane, not just the bind-walk.
query I
SELECT birdshot_authorize('gsess', 'DROP TABLE main.gtab');
----
false

query I
UNDENY DROP ON main.gtab FROM grantee1;
----
UNDENY

query I
SELECT birdshot_authorize('gsess', 'DROP TABLE main.gtab');
----
true

# ---- WIRE-DENY holds for a DENY statement (mandatory security re-check) ------
# The parser now claims DENY, so a wire-submitted DENY is auto-denied by the same
# bare-parser-throws gate as a wire GRANT — a token can never author a deny either.
query I
SELECT birdshot_authorize('gsess', 'DENY SELECT ON sales.orders TO grantee1');
----
false

# …and it was ineffective: grantee1 still reads sales.orders (deny never applied).
query I
SELECT birdshot_authorize('gsess', 'SELECT * FROM sales.orders');
----
true

# ---- fail-closed: unenforced privilege in a DENY is a hard error -------------
statement error
DENY TRIGGER ON sales.orders TO grantee1;
----
unknown or unenforced privilege

# ---- deferred: a column list on DENY is out of scope (clear error) -----------
statement error
DENY SELECT (ssn) ON sales.pii TO grantee1;
----
column lists on DENY

# ==========================================================================
# Lazy grant-store hydration (spec §12b/§12c) — local-table backend
# ==========================================================================
#
# A "table" store holds raw GRANT SQL keyed by grantee. birdshot_authenticate
# lazy-pulls a subject's rows (∪ PUBLIC ∪ transitively each granted role's rows)
# the FIRST time it binds that subject, parses each row through the native GRANT
# path (parse-ONLY, never executed), and applies the result to live State — so a
# subject birdshot has NEVER seen a scalar grant for is enforced on the next
# authorize. Any store error / unparseable row FAILS CLOSED (subject poisoned ->
# denied). The store table stays unaddressable to any wire token in BOTH planes.

# Rebuild the protected store fixture with the real cross-language column contract.
statement ok
DROP TABLE __birdshot_grants;

statement ok
CREATE TABLE __birdshot_grants(grantee_kind VARCHAR, grantee VARCHAR, stmt VARCHAR, version BIGINT);

# §12d freshness gate: in table mode the store epoch is REQUIRED (fail-closed — every
# authorize reads __birdshot_meta; a missing/unreadable epoch DENIES). This static row
# (epoch=0, never bumped) means exactly one hydration and no re-hydration, so the
# assertions below hold unchanged while still exercising the freshness read path. A
# separate case further down BUMPS this epoch to prove REVOKE takes effect.
statement ok
CREATE TABLE __birdshot_meta(epoch BIGINT);

statement ok
INSERT INTO __birdshot_meta VALUES (0);

statement ok
CREATE TABLE main.hyd(id INT, title VARCHAR);

# A role-only table (NO public/subject grant) so the transitive-role path is tested in
# ISOLATION — a bare `TO r1` here would silently key to the subject-self-role of "r1"
# (which bob, a member of the ROLE r1, never holds) and under-enforce; the store contract
# is that a grantee_kind='role' row's stmt MUST use `TO ROLE <r>` (§12a/§12f).
statement ok
CREATE TABLE main.hrole(id INT, title VARCHAR);

# alice: a direct subject grant (no scalar birdshot_add_role_grant ever ran for her).
statement ok
INSERT INTO __birdshot_grants VALUES ('subject', 'alice', 'GRANT SELECT ON main.hyd TO alice', 0);

# alice-ONLY table (no PUBLIC, no role grant): her access is reachable ONLY via her
# direct subject grant, so the §12d freshness case below can REVOKE it and observe a
# genuine deny (revoking her grant on main.hyd would NOT deny her — PUBLIC still covers it).
statement ok
CREATE TABLE main.asolo(id INT, title VARCHAR);

statement ok
INSERT INTO __birdshot_grants VALUES ('subject', 'alice', 'GRANT SELECT ON main.asolo TO alice', 0);

# bob: role membership + the role's own grant on a PUBLIC-free table -> transitive
# hydration, genuinely isolated (bob reaches main.hrole ONLY via role r1).
statement ok
INSERT INTO __birdshot_grants VALUES ('subject', 'bob', 'GRANT r1 TO bob', 0);

statement ok
INSERT INTO __birdshot_grants VALUES ('role', 'r1', 'GRANT SELECT ON main.hrole TO ROLE r1', 0);

# PUBLIC: must reach a subject with no subject/role rows of its own (carol).
statement ok
INSERT INTO __birdshot_grants VALUES ('public', '', 'GRANT SELECT ON main.hyd TO PUBLIC', 0);

# mallory: a non-GRANT store row (parser -> DISPLAY_ORIGINAL_ERROR) -> fail-closed poison.
statement ok
INSERT INTO __birdshot_grants VALUES ('subject', 'mallory', 'DROP TABLE main.hyd', 0);

# mo: a GRANT-shaped but MALFORMED row (parser -> DISPLAY_EXTENSION_ERROR) exercises the
# OTHER parse-failure branch; must ALSO fail closed even though a VALID grant precedes it
# in the same key (per-key all-or-nothing: one bad row denies the whole subject).
statement ok
INSERT INTO __birdshot_grants VALUES ('subject', 'mo', 'GRANT SELECT ON main.hyd TO mo', 0);

statement ok
INSERT INTO __birdshot_grants VALUES ('subject', 'mo', 'GRANT bogus_priv ON main.hyd TO mo', 0);

# dx: a DRIFTED row — grantee_kind='subject'/'dx' (the pull key) but the stmt applies to
# ROLE rr (the apply key). dx is a member of rr, so dx reaches main.drift via rr. This
# distinguishes the flush keying: apply writes role_key `rr`; a column-based flush would
# erase `subject-self-role(dx)` and STRAND the rr grant past a delete-on-revoke (fail OPEN).
# FlushHydrated erases the APPLIED role_key (rr), so the §12d case below denies correctly.
statement ok
CREATE TABLE main.drift(id INT, title VARCHAR);

statement ok
INSERT INTO __birdshot_grants VALUES ('subject', 'dx', 'GRANT rr TO dx', 0);

statement ok
INSERT INTO __birdshot_grants VALUES ('subject', 'dx', 'GRANT SELECT ON main.drift TO ROLE rr', 0);

# ---- config: service tokens bind sessions to the store subjects -------------
query I
SELECT birdshot_reset_config();
----
ok

query I
SELECT birdshot_set_auth('', '', 'dev');
----
ok

query I
SELECT birdshot_add_service_token('hy-alice', 'alice');
----
ok

query I
SELECT birdshot_add_service_token('hy-bob', 'bob');
----
ok

query I
SELECT birdshot_add_service_token('hy-carol', 'carol');
----
ok

query I
SELECT birdshot_add_service_token('hy-mallory', 'mallory');
----
ok

query I
SELECT birdshot_add_service_token('hy-mo', 'mo');
----
ok

query I
SELECT birdshot_add_service_token('hy-dx', 'dx');
----
ok

query I
SELECT birdshot_commit_config();
----
ok

# Select the table store AFTER commit. Hydration writes direct-to-live, so no
# birdshot_commit_config() may follow any authenticate below (it would clobber).
query I
SELECT birdshot_set_grant_store('table', ':memory:');
----
table

# ---- authenticate triggers the lazy pull (subjects birdshot has never seen) --
query I
SELECT birdshot_authenticate('hsa', 'hy-alice', '');
----
true

query I
SELECT birdshot_authenticate('hsb', 'hy-bob', '');
----
true

query I
SELECT birdshot_authenticate('hsc', 'hy-carol', '');
----
true

# mallory / mo still bind a session (fail-closed is enforced at authorize, not here).
query I
SELECT birdshot_authenticate('hsm', 'hy-mallory', '');
----
true

query I
SELECT birdshot_authenticate('hso', 'hy-mo', '');
----
true

# alice: direct subject grant enforced — proves lazy hydration (no scalar grant existed).
query I
SELECT birdshot_authorize('hsa', 'SELECT id FROM main.hyd');
----
true

# bob: transitive role r1 grant enforced on the PUBLIC-free table — this can ONLY pass
# via the role path (no PUBLIC/subject grant on main.hrole), so it genuinely isolates it.
query I
SELECT birdshot_authorize('hsb', 'SELECT id FROM main.hrole');
----
true

# carol (PUBLIC only, no role) is DENIED on main.hrole — proves the role path is what
# gives bob access there, and that PUBLIC does NOT leak onto the role-only table.
query I
SELECT birdshot_authorize('hsc', 'SELECT id FROM main.hrole');
----
false

# carol: only PUBLIC reaches her (no subject/role rows) — allowed on the PUBLIC table.
query I
SELECT birdshot_authorize('hsc', 'SELECT id FROM main.hyd');
----
true

# FAIL-CLOSED: mallory's malformed store row poisons her -> DENIED, even though the
# PUBLIC grant would otherwise cover this exact read.
query I
SELECT birdshot_authorize('hsm', 'SELECT id FROM main.hyd');
----
false

# FAIL-CLOSED (other branch): mo's malformed GRANT row poisons him -> DENIED, even
# though a valid `GRANT SELECT ON main.hyd TO mo` sits in the SAME key before it.
query I
SELECT birdshot_authorize('hso', 'SELECT id FROM main.hyd');
----
false

# A subject with no store rows at all is a clean empty hydration (NOT poison): it is
# simply un-granted -> default-deny (not a store error).
query I
SELECT birdshot_authorize('hsa', 'SELECT id FROM main.nope');
----
false

# PROTECTION HOLDS in both planes: a wire token can never read the store table,
# even the very subject whose grants it holds, and even column-projected.
query I
SELECT birdshot_authorize('hsa', 'SELECT * FROM __birdshot_grants');
----
false

query I
SELECT birdshot_authorize('hsa', 'SELECT stmt FROM __birdshot_grants WHERE grantee = ''alice''');
----
false

# ==========================================================================
# Freshness gate (spec §12d) — strong per-query epoch, fail-closed
# ==========================================================================
#
# Every authorize (table mode) reads __birdshot_meta.epoch. When it advances past
# the epoch birdshot last flushed-and-rehydrated at, the WHOLE hydrated cache is
# flushed GLOBALLY (once) and each subject is re-hydrated lazily on its next
# authorize. A store-side REVOKE therefore takes effect WITHOUT re-authenticating.

# ---- unchanged epoch (0): no spurious re-hydration, prior decisions hold -----
# Asserted BEFORE any bump so these pass because the cache is untouched (not merely
# because a re-hydrate happened to re-grant). alice + carol were hydrated above.
query I
SELECT birdshot_authorize('hsa', 'SELECT id FROM main.asolo');
----
true

query I
SELECT birdshot_authorize('hsc', 'SELECT id FROM main.hyd');
----
true

# ---- store-side REVOKE + epoch bump -> deny on the NEXT query ----------------
# Append a REVOKE row for alice at a HIGHER version (append-only writer, §12d
# strategy a). ORDER BY version applies GRANT(v0) then REVOKE(v1) -> RevokeLive
# nets to no grant. version is BIGINT; alice's original asolo grant row is version 0.
statement ok
INSERT INTO __birdshot_grants VALUES ('subject', 'alice', 'REVOKE SELECT ON main.asolo FROM alice', 1);

# Bump the epoch. This is the ONLY signal; no re-authenticate, no config reload.
statement ok
UPDATE __birdshot_meta SET epoch = 1;

# alice's NEXT authorize (same session hsa) now DENIES on her formerly-granted
# alice-only table: epoch advanced -> global flush -> alice re-hydrates GRANT then
# REVOKE in version order -> revoked. (Her PUBLIC access to main.hyd is untouched.)
query I
SELECT birdshot_authorize('hsa', 'SELECT id FROM main.asolo');
----
false

# CROSS-SUBJECT NON-STRANDING: the flush was GLOBAL (it cleared carol's PUBLIC key
# and bob's role key too), but re-hydrate is PER-AUTHORIZE, so carol and bob are
# re-populated on their own next query — NOT silently stranded by alice's bump.
query I
SELECT birdshot_authorize('hsc', 'SELECT id FROM main.hyd');
----
true

query I
SELECT birdshot_authorize('hsb', 'SELECT id FROM main.hrole');
----
true

# Idempotent at the same epoch: alice stays denied, carol stays allowed (no churn).
query I
SELECT birdshot_authorize('hsa', 'SELECT id FROM main.asolo');
----
false

query I
SELECT birdshot_authorize('hsc', 'SELECT id FROM main.hyd');
----
true

# ---- fail-closed: epoch unreadable -> DENY (table mode requires the epoch) ----
# Drop the meta table; the epoch read now fails -> every table-mode authorize denies,
# even for a subject (carol) that is cleanly hydrated and granted via PUBLIC.
statement ok
DROP TABLE __birdshot_meta;

query I
SELECT birdshot_authorize('hsc', 'SELECT id FROM main.hyd');
----
false

# Restore the meta table (epoch back at 1, matching hydrated_epoch_): reads succeed
# again, no flush, and carol is served from the still-warm cache -> allowed.
statement ok
CREATE TABLE __birdshot_meta(epoch BIGINT);

statement ok
INSERT INTO __birdshot_meta VALUES (1);

query I
SELECT birdshot_authorize('hsc', 'SELECT id FROM main.hyd');
----
true

# ---- flush keying: delete-on-revoke of a DRIFTED grant must take effect -------
# dx reaches main.drift via role rr — a grant whose store column is subject/dx but whose
# stmt applies TO ROLE rr (apply key = rr). Authenticate; the first query hydrates dx at
# the current epoch (1 == hydrated_epoch_, so no flush, just ensure_hydrated).
query I
SELECT birdshot_authenticate('hsdx', 'hy-dx', '');
----
true

query I
SELECT birdshot_authorize('hsdx', 'SELECT id FROM main.drift');
----
true

# Delete-on-revoke: drop the drift grant row (keep the rr membership) and bump the epoch.
# There is NO appended REVOKE row, so the ONLY way the next query denies is if FlushHydrated
# erased the APPLIED role_key (rr). A column-based flush would erase subject-self-role(dx),
# strand the rr grant, and leave dx ALLOWED — a fail-OPEN this asserts against.
statement ok
DELETE FROM __birdshot_grants WHERE grantee = 'dx' AND stmt LIKE '%main.drift%';

statement ok
UPDATE __birdshot_meta SET epoch = 2;

query I
SELECT birdshot_authorize('hsdx', 'SELECT id FROM main.drift');
----
false

# ==========================================================================
# Hydrated DENY (spec §12) — store-row DENY, deny-wins + flush-on-epoch-bump
# ==========================================================================
#
# A DENY row in __birdshot_grants (grantee_kind/grantee like a GRANT row) is pulled +
# parsed (parse-only) + applied to role_denies, then enforced deny-wins. And on an epoch
# bump the whole hydrated cache — role_denies included — is flushed and re-pulled, so a
# store-side DENY add takes effect (fail-closed) and a store-side DENY delete lifts
# (proving denies flush; no stale deny lingers). Epoch is at 2 here (dx case above).

statement ok
CREATE TABLE main.hpii(id INT, ssn VARCHAR);

# alice gets a store GRANT on main.hpii (subject row); bump the epoch so the global flush
# + per-subject re-hydrate picks it up on her next authorize.
statement ok
INSERT INTO __birdshot_grants VALUES ('subject', 'alice', 'GRANT SELECT ON main.hpii TO alice', 3);

statement ok
UPDATE __birdshot_meta SET epoch = 3;

# Granted, no deny yet -> allowed.
query I
SELECT birdshot_authorize('hsa', 'SELECT id FROM main.hpii');
----
true

# ---- store DENY row pulled + enforced (deny-wins over the hydrated grant) -----
# no-fail-open-on-added-DENY: append a DENY row + bump epoch -> next query DENIES.
statement ok
INSERT INTO __birdshot_grants VALUES ('subject', 'alice', 'DENY SELECT ON main.hpii TO alice', 4);

statement ok
UPDATE __birdshot_meta SET epoch = 4;

query I
SELECT birdshot_authorize('hsa', 'SELECT id FROM main.hpii');
----
false

# ---- freshness: DELETE the DENY row + bump epoch -> denies FLUSH -> ALLOWS -----
# Proves FlushHydrated erases role_denies: no appended UNDENY row exists, so the ONLY
# way the next query allows is the flush dropping the hydrated deny and the re-pull
# (grant still present, deny gone) restoring access. A deny NOT flushed here would be
# fail-safe (over-deny) — but it would also break a legitimate lift, so we assert allow.
statement ok
DELETE FROM __birdshot_grants WHERE grantee = 'alice' AND stmt LIKE 'DENY%';

statement ok
UPDATE __birdshot_meta SET epoch = 5;

query I
SELECT birdshot_authorize('hsa', 'SELECT id FROM main.hpii');
----
true
