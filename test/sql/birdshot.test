# name: test/sql/birdshot.test
# description: birdshot auth/authz hooks, ACL, revocation, audit (dev mode)
# group: [sql]
#
# This suite calls birdshot_authorize() IN-PROCESS (decision logic). Its
# end-to-end companion, test/e2e/birdshot.e2e.ts (`make test-e2e`), replays every
# authorize assertion below through a real quack client↔server with birdshot wired
# in as the auth/authz hooks, proving each decision is enforced on the wire.

# Functions don't exist before the extension is loaded.
statement error
SELECT birdshot_status();
----
Catalog Error

require birdshot

# ---- configure (dev mode: JWT claims trusted without signature) -------------

query I
SELECT birdshot_reset_config();
----
ok

query I
SELECT birdshot_set_auth('', '', 'dev');
----
ok

# role 'reader' may read main.todos; 'peer' service token maps to it.
query I
SELECT birdshot_add_role_grant('reader', 'main.todos', 'read');
----
ok

query I
SELECT birdshot_add_user_role('alice', 'reader');
----
ok

query I
SELECT birdshot_add_service_token('svc-token-123', 'alice');
----
ok

query I
SELECT birdshot_commit_config();
----
ok

query I
SELECT birdshot_status() LIKE 'mode=dev%';
----
true

# ---- catalog fixtures -------------------------------------------------------
#
# Bind-and-walk binds the query against the real catalog, so the tables an
# authorization test references must EXIST (a query over a non-existent table
# can't bind and is denied, fail-closed — which is correct). These mirror the
# lake tables that exist in production. `main.todos` is the granted table;
# `secrets` exists but is NOT granted, so its deny tests the real
# exists-but-ungranted property (not an incidental bind failure).

statement ok
CREATE TABLE main.todos(id INT, title VARCHAR);

statement ok
CREATE TABLE secrets(id INT, title VARCHAR);

# `whoami()` is a quack-provided node-identity table macro that exists in
# production (the authz hook runs on a quack connection). The bare test DB does not
# load quack, so bind-and-walk could not bind it; stub it to mirror prod. The
# pre-filter still allowlists it by NAME (IsSafeTableFunc), so this stays a real S7
# test — a non-allowlisted table function is denied at the pre-filter regardless.
statement ok
CREATE MACRO whoami() AS TABLE (SELECT 'node' AS node_id);

# ---- authentication ---------------------------------------------------------

# Static service token authenticates as user 'alice'.
query I
SELECT birdshot_authenticate('sess1', 'svc-token-123', 'ignored');
----
true

# A dev-mode user JWT { "sub": "alice" } also authenticates.
query I
SELECT birdshot_authenticate('sess2', 'eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0.eyJzdWIiOiJhbGljZSJ9.x', '');
----
true

# Garbage token is rejected.
query I
SELECT birdshot_authenticate('sess3', 'not-a-token', '');
----
false

# ---- authorization ----------------------------------------------------------

# Granted read on main.todos -> allow.
query I
SELECT birdshot_authorize('sess1', 'SELECT * FROM main.todos');
----
true

# Unqualified todos matches the grant by suffix -> allow.
query I
SELECT birdshot_authorize('sess1', 'SELECT count(*) FROM todos');
----
true

# A table with no grant -> deny.
query I
SELECT birdshot_authorize('sess1', 'SELECT * FROM secrets');
----
false

# Write to a read-only granted table -> deny. (Well-formed arity so the denial is
# the write-grant check, not an incidental bind column-count error.)
query I
SELECT birdshot_authorize('sess1', 'INSERT INTO main.todos VALUES (1, ''x'')');
----
false

# Forbidden statement class (could subvert the sandbox) -> deny.
query I
SELECT birdshot_authorize('sess1', 'ATTACH ''evil.db'' AS x');
----
false

# Zero-table / introspection statement -> allowed (federation handshake).
query I
SELECT birdshot_authorize('sess1', 'SELECT 42');
----
true

# A non-granted table hidden in a WHERE subquery must NOT slip through.
query I
SELECT birdshot_authorize('sess1', 'SELECT * FROM main.todos WHERE id IN (SELECT id FROM secrets)');
----
false

# A forbidden statement hidden after a benign one in a batch must NOT slip through.
query I
SELECT birdshot_authorize('sess1', 'BEGIN; DROP TABLE main.todos');
----
false

# A peer must NOT be able to call birdshot's own mutators (zero-table SELECT).
query I
SELECT birdshot_authorize('sess1', 'SELECT birdshot_revoke(''user'', ''admin'', '''', NULL)');
----
false

query I
SELECT birdshot_authorize('sess1', 'SELECT birdshot_add_role_grant(''peer'', ''*'', ''write'')');
----
false

# File / dynamic readers must be denied (arbitrary file read / SSRF).
query I
SELECT birdshot_authorize('sess1', 'SELECT read_blob(''/etc/passwd'')');
----
false

query I
SELECT birdshot_authorize('sess1', 'SELECT * FROM read_csv(''/etc/passwd'')');
----
false

query I
SELECT birdshot_authorize('sess1', 'SELECT * FROM query_table(''secrets'')');
----
false

# A dangerous reader hidden in a WHERE subquery is still caught.
query I
SELECT birdshot_authorize('sess1', 'SELECT * FROM main.todos WHERE title = read_text(''/etc/hostname'')');
----
false

# EXPLAIN ANALYZE executes its child -> the child is ACL-checked, not waved through.
query I
SELECT birdshot_authorize('sess1', 'EXPLAIN ANALYZE SELECT * FROM secrets');
----
false

# Introspection table functions stay allowed (quack ATTACH handshake needs these).
query I
SELECT birdshot_authorize('sess1', 'SELECT * FROM duckdb_tables()');
----
true

# PRAGMA is denied (reparses into statements that skip re-authorize; some pragmas
# reach settings / file-write primitives).
query I
SELECT birdshot_authorize('sess1', 'PRAGMA table_info(''main.todos'')');
----
false

# A CAST to an autoload-backed type (json/spatial/inet) is denied even on a
# granted table — it can pull in an extension at bind time.
query I
SELECT birdshot_authorize('sess1', 'SELECT CAST(title AS JSON) FROM main.todos');
----
false

# Unknown session -> deny.
query I
SELECT birdshot_authorize('ghost', 'SELECT * FROM main.todos');
----
false

# ---- instant revocation -----------------------------------------------------

query I
SELECT birdshot_revoke('user', 'alice', 'compromised', NULL);
----
ok

# alice's existing session is cut off on her next query.
query I
SELECT birdshot_authorize('sess1', 'SELECT * FROM main.todos');
----
false

query I
SELECT birdshot_unrevoke('user', 'alice');
----
ok

query I
SELECT birdshot_authorize('sess1', 'SELECT * FROM main.todos');
----
true

# ---- audit drain ------------------------------------------------------------

# Every auth/authz call above logged an entry; draining returns them and clears.
query I
SELECT length(birdshot_log_drain(1000)) > 0;
----
true

query I
SELECT length(birdshot_log_drain(1000));
----
0

# ---- column + time-window constraint enforcement ----------------------------
#
# Real tables so positional refs (#N) resolve against the catalog. sqllogictest's
# default catalog is 'memory'; constraints resolve unqualified `FROM t` there.

statement ok
CREATE TABLE t(c1 INT, c2 INT, c3 INT, c4 INT, c5 INT GENERATED ALWAYS AS (c1 + 1));

statement ok
CREATE TABLE t2(c1 INT, c2 INT, c3 INT, c4 INT);

statement ok
CREATE TABLE win_tbl(c1 INT, c2 INT);

# Fresh config: bob may read t, t2, win_tbl; t is column-restricted to {c1,c2};
# win_tbl carries an all-day window (deterministic). t2 is unconstrained.
query I
SELECT birdshot_reset_config();
----
ok

query I
SELECT birdshot_set_auth('', '', 'dev');
----
ok

query I
SELECT birdshot_set_lake_catalog('memory');
----
ok

query I
SELECT birdshot_add_role_grant('colrole', 'main.t', 'read');
----
ok

query I
SELECT birdshot_add_role_grant('colrole', 'main.t2', 'read');
----
ok

query I
SELECT birdshot_add_role_grant('colrole', 'main.win_tbl', 'read');
----
ok

# Write grants so the DML (R6) cases reach column enforcement rather than
# denying at the table-grant stage. The {c1,c2} column constraint on main.t
# still applies to writes (column allow-lists are not action-scoped).
query I
SELECT birdshot_add_role_grant('colrole', 'main.t', 'write');
----
ok

query I
SELECT birdshot_add_role_grant('colrole', 'main.t2', 'write');
----
ok

query I
SELECT birdshot_add_grant_constraint('colrole', 'main.t', 'c1,c2', '', '');
----
ok

# All-day window -> always in-window (deterministic, not wall-clock-flaky).
query I
SELECT birdshot_add_grant_constraint('colrole', 'main.win_tbl', '', '00:00', '23:59');
----
ok

query I
SELECT birdshot_add_user_role('bob', 'colrole');
----
ok

query I
SELECT birdshot_commit_config();
----
ok

# Two constraint entries are live (main.t columns, main.win_tbl window).
query I
SELECT birdshot_status() LIKE '%constraints=2';
----
true

query I
SELECT birdshot_authenticate('bsess', 'eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0.eyJzdWIiOiJib2IifQ.x', '');
----
true

# Form A (positional push-down): allowed columns -> allow; a non-allowed
# position (#3 == c3) -> deny; star pre-expanded to #1..#4 -> deny (c3,c4 not allowed).
query I
SELECT birdshot_authorize('bsess', 'SELECT #1, #2 FROM t');
----
true

query I
SELECT birdshot_authorize('bsess', 'SELECT #1, #3 FROM t');
----
false

query I
SELECT birdshot_authorize('bsess', 'SELECT #1, #2, #3, #4 FROM t');
----
false

# Form B (verbatim names via lake.query): allowed names -> allow; non-allowed
# name -> deny; literal unqualified star -> deny (cannot enumerate).
query I
SELECT birdshot_authorize('bsess', 'SELECT c1, c2 FROM main.t');
----
true

query I
SELECT birdshot_authorize('bsess', 'SELECT c1, c3 FROM main.t');
----
false

query I
SELECT birdshot_authorize('bsess', 'SELECT * FROM main.t');
----
false

# A non-allowed column hidden in a WHERE clause is also charged -> deny.
query I
SELECT birdshot_authorize('bsess', 'SELECT c1 FROM main.t WHERE c3 > 0');
----
false

# A non-allowed column referenced only in ORDER BY / GROUP BY is still charged.
query I
SELECT birdshot_authorize('bsess', 'SELECT c1 FROM main.t ORDER BY c3');
----
false

query I
SELECT birdshot_authorize('bsess', 'SELECT count(c1) FROM main.t GROUP BY c3');
----
false

# Allowed columns across SELECT + ORDER BY -> allow.
query I
SELECT birdshot_authorize('bsess', 'SELECT c1 FROM main.t ORDER BY c2');
----
true

# Unconstrained table: every column / star is fine.
query I
SELECT birdshot_authorize('bsess', 'SELECT #1, #2, #3, #4 FROM t2');
----
true

query I
SELECT birdshot_authorize('bsess', 'SELECT * FROM main.t2');
----
true

# Window-only table (no column allow-list): readable in-window via a plain star.
query I
SELECT birdshot_authorize('bsess', 'SELECT * FROM main.win_tbl');
----
true

# ---- walker completeness / fail-closed (adversarial review R1-R8) ------------

# R1: every non-enumerable star variant denies on a column-constrained table.
query I
SELECT birdshot_authorize('bsess', 'SELECT t.* FROM main.t');
----
false

query I
SELECT birdshot_authorize('bsess', 'SELECT x.* FROM main.t x');
----
false

query I
SELECT birdshot_authorize('bsess', 'SELECT COLUMNS(''.*'') FROM main.t');
----
false

query I
SELECT birdshot_authorize('bsess', 'SELECT COLUMNS(''c[34]'') FROM main.t');
----
false

# R1 (no over-deny): COLUMNS(*) over an unconstrained table is fine.
query I
SELECT birdshot_authorize('bsess', 'SELECT COLUMNS(''.*'') FROM main.t2');
----
true

# R2: PIVOT/UNPIVOT source table is gated. secrets is ungranted -> deny.
query I
SELECT birdshot_authorize('bsess', 'SELECT * FROM secrets UNPIVOT(v FOR n IN (c1, c2))');
----
false

# R2 (no over-deny): UNPIVOT over a granted unconstrained table -> allow.
query I
SELECT birdshot_authorize('bsess', 'SELECT * FROM main.t2 UNPIVOT(v FOR n IN (c1, c2))');
----
true

# R3: a scalar subquery hidden in a VALUES cell is gated. secrets -> deny.
query I
SELECT birdshot_authorize('bsess', 'SELECT * FROM (VALUES ((SELECT max(c1) FROM secrets))) AS v(c)');
----
false

# R3 (no over-deny): a plain VALUES list with no base table -> allow.
query I
SELECT birdshot_authorize('bsess', 'SELECT * FROM (VALUES (1), (2)) AS v(c)');
----
true

# R4: WITH RECURSIVE body reads are gated even when the CTE is named after a
# granted table. The recursive body reads secrets -> deny.
query I
SELECT birdshot_authorize('bsess', 'WITH RECURSIVE t2 AS (SELECT c1 FROM secrets UNION SELECT c1 FROM t2) SELECT * FROM t2');
----
false

# R5: a forbidden column in a JOIN ON predicate is charged -> deny.
query I
SELECT birdshot_authorize('bsess', 'SELECT t.c1 FROM main.t t JOIN main.t2 x ON t.c3 = x.c1');
----
false

# R5 (no over-deny): qualified allowed columns across a join -> allow.
query I
SELECT birdshot_authorize('bsess', 'SELECT t.c1 FROM main.t t JOIN main.t2 x ON t.c2 = x.c1');
----
true

# R6: DELETE WHERE referencing an ungranted table via subquery -> deny.
query I
SELECT birdshot_authorize('bsess', 'DELETE FROM main.t2 WHERE c1 IN (SELECT c1 FROM secrets)');
----
false

# R6: UPDATE ... RETURNING a forbidden column on a constrained table -> deny.
query I
SELECT birdshot_authorize('bsess', 'UPDATE main.t SET c1 = 1 RETURNING c3');
----
false

# R7 (fail-closed default does NOT over-deny benign tableless / introspection):
query I
SELECT birdshot_authorize('bsess', 'SELECT 42');
----
true

query I
SELECT birdshot_authorize('bsess', 'SELECT * FROM duckdb_tables()');
----
true

# R8: a forbidden column hidden only inside a LIMIT subquery is charged -> deny.
query I
SELECT birdshot_authorize('bsess', 'SELECT c1 FROM main.t LIMIT (SELECT c3 FROM main.t)');
----
false

# SHOW/DESCRIBE/SUMMARIZE: SUMMARIZE reads all columns of its source and DESCRIBE
# are their own statement classes -> hit the forbidden-statement default (deny),
# so they cannot leak ungranted tables or constrained columns. SHOW (no source
# table) stays allowed for the introspection handshake.
query I
SELECT birdshot_authorize('bsess', 'SUMMARIZE secrets');
----
false

query I
SELECT birdshot_authorize('bsess', 'SUMMARIZE main.t');
----
false

query I
SELECT birdshot_authorize('bsess', 'DESCRIBE secrets');
----
false

query I
SELECT birdshot_authorize('bsess', 'SHOW tables');
----
true

# UNPIVOT IN-list columns are collected (they land in pivot_expressions), so c3/c4
# are charged against the {c1,c2} constraint -> deny.
query I
SELECT birdshot_authorize('bsess', 'SELECT v FROM main.t UNPIVOT(v FOR n IN (c3, c4))');
----
false

# ---- round-2 review fixes (S1-S7) -------------------------------------------

# S1: NATURAL JOIN keys are bind-time invisible -> fail closed on the constrained
# side. (Use SELECT 1 to avoid NATURAL-coalesce qualification quirks.)
query I
SELECT birdshot_authorize('bsess', 'SELECT 1 FROM main.t NATURAL JOIN main.t2');
----
false

# S1 (no over-deny): NATURAL JOIN of two unconstrained granted tables -> allow.
query I
SELECT birdshot_authorize('bsess', 'SELECT 1 FROM main.t2 NATURAL JOIN main.win_tbl');
----
true

# S2: a PIVOT IN-list subquery reading an ungranted table is gated -> deny.
query I
SELECT birdshot_authorize('bsess', 'PIVOT main.t2 ON c1 IN ((SELECT c1 FROM secrets)) USING sum(c2)');
----
false

# S2 (no over-deny): plain IN-list label idents over a granted table -> allow.
query I
SELECT birdshot_authorize('bsess', 'PIVOT main.t2 ON c1 IN (1, 2) USING sum(c2)');
----
true

# S3: a dangerous CAST hidden in an introspection-fn arg is still caught -> deny.
query I
SELECT birdshot_authorize('bsess', 'SELECT * FROM pragma_table_info(CAST(''x'' AS JSON))');
----
false

# S3 (no over-deny): literal-arg / no-arg introspection the handshake needs.
query I
SELECT birdshot_authorize('bsess', 'SELECT * FROM pragma_table_info(''main.t'')');
----
true

query I
SELECT birdshot_authorize('bsess', 'SELECT * FROM duckdb_columns()');
----
true

# S4: per-qualifier stars. A qualified star over a DIFFERENT unconstrained table
# does NOT deny the constrained table; only a bare star or t.* does.
query I
SELECT birdshot_authorize('bsess', 'SELECT x.* FROM main.t t JOIN main.t2 x ON t.c1 = x.c1');
----
true

query I
SELECT birdshot_authorize('bsess', 'SELECT t.* FROM main.t t JOIN main.t2 x ON t.c1 = x.c1');
----
false

query I
SELECT birdshot_authorize('bsess', 'SELECT * FROM main.t t JOIN main.t2 x ON t.c1 = x.c1');
----
false

# S5: a CTE ref is not charged as a phantom ungranted table -> allow.
query I
SELECT birdshot_authorize('bsess', 'WITH cte AS (SELECT c1 FROM main.t2) SELECT * FROM cte');
----
true

# S5: the CTE body's real reads stay charged -> ungranted secrets -> deny.
query I
SELECT birdshot_authorize('bsess', 'WITH cte AS (SELECT s FROM secrets) SELECT * FROM cte');
----
false

# S5 scope isolation: a real ungranted base table sharing a name with a CTE
# declared in a SEPARATE (sibling subquery) scope must still DENY.
query I
SELECT birdshot_authorize('bsess', 'SELECT * FROM (WITH cte AS (SELECT 1) SELECT 1) q, cte');
----
false

# S5 self-shadow (must DENY): a non-recursive CTE cannot reference itself, so the
# body's `FROM t` is the REAL constrained table — its forbidden c3 must be charged.
query I
SELECT birdshot_authorize('bsess', 'WITH t AS (SELECT c3 FROM t) SELECT * FROM t');
----
false

# S5 preceding-sibling scope (must ALLOW): a later CTE may reference an earlier one.
query I
SELECT birdshot_authorize('bsess', 'WITH a AS (SELECT c1 FROM main.t2), b AS (SELECT c1 FROM a) SELECT c1 FROM b');
----
true

# S5 recursive no-over-deny: a RECURSIVE self-ref over a granted unconstrained
# table must still ALLOW (the self-ref is not charged as a phantom table).
query I
SELECT birdshot_authorize('bsess', 'WITH RECURSIVE r AS (SELECT c1 FROM main.t2 UNION SELECT c1 FROM r) SELECT * FROM r');
----
true

# S8 (bind-and-walk): multi-table columns are resolved to their REAL table by the
# binder (each BoundColumnRef carries its own table_index), so a column allowed on
# the constrained table passes and a forbidden one is caught -- no qualifier
# heuristics. Note: a GENUINELY AMBIGUOUS unqualified column across a join (a bare
# name present in BOTH tables, e.g. `SELECT c1 FROM main.t JOIN main.t2`) is INVALID
# SQL -- plain DuckDB throws "Ambiguous reference to column name c1", and so does the
# agent's own DuckDB in production -- so bind-and-walk fails closed (DENY) on it.
# That is correct, so the ALLOW cases below use the well-formed disambiguated forms
# (qualified / USING / single-table-scoped) an agent must actually write.

# ALLOW: an allowed column scoped to the constrained table across a join (the
# `t.c1`/USING forms below also cover the unqualified-resolution intent).
query I
SELECT birdshot_authorize('bsess', 'SELECT main.t.c1 FROM main.t JOIN main.t2 ON main.t.c1 = main.t2.c1');
----
true

# DENY: a forbidden column on the constrained table across a join (c3 in C(main.t),
# not in {c1,c2}).
query I
SELECT birdshot_authorize('bsess', 'SELECT main.t.c3 FROM main.t JOIN main.t2 ON main.t.c1 = main.t2.c1');
----
false

# Control: an unqualified column present in BOTH joined tables is AMBIGUOUS -- the
# binder throws "Ambiguous reference to column name", so bind-and-walk fails closed
# -> DENY. (Plain DuckDB rejects this query too; an agent must qualify it. This is
# at least as strict as the old parse-walk heuristic, which guessed a table.)
query I
SELECT birdshot_authorize('bsess', 'SELECT c1 FROM main.t JOIN main.t2 ON main.t.c1 = main.t2.c1');
----
false

# S8 subsumes S6: USING(allowed) -> allow, USING(forbidden) -> deny.
query I
SELECT birdshot_authorize('bsess', 'SELECT t.c1 FROM main.t t JOIN main.t2 x USING (c1)');
----
true

query I
SELECT birdshot_authorize('bsess', 'SELECT t.c1 FROM main.t t JOIN main.t2 x USING (c3)');
----
false

# WHERE-subquery makes it multi-table; unqualified allowed cols -> allow.
query I
SELECT birdshot_authorize('bsess', 'SELECT c1 FROM main.t WHERE c2 IN (SELECT c1 FROM main.t2)');
----
true

# UNION (multi-table) with allowed unqualified cols -> allow.
query I
SELECT birdshot_authorize('bsess', 'SELECT c1 FROM main.t UNION SELECT c1 FROM main.t2');
----
true

# A qualified column on the UNCONSTRAINED side (c3 is t2's) -> allow.
query I
SELECT birdshot_authorize('bsess', 'SELECT t2.c3 FROM main.t t JOIN main.t2 t2 ON t.c1 = t2.c1');
----
true

# A computed SELECT alias referenced in ORDER BY resolves to no catalog column
# -> not charged -> allow. (Source column qualified to disambiguate across the join;
# the alias `x` itself is not a catalog column.)
query I
SELECT birdshot_authorize('bsess', 'SELECT main.t.c1 + 1 AS x FROM main.t JOIN main.t2 ON main.t.c1 = main.t2.c1 ORDER BY x');
----
true

# Schema-qualified ref to the constrained table: GetTableName() returns the table
# component (`t`), so a forbidden schema-qualified col is still caught -> deny.
query I
SELECT birdshot_authorize('bsess', 'SELECT main.t.c3 FROM main.t JOIN main.t2 ON main.t.c1 = main.t2.c1');
----
false

# ...and the allowed schema-qualified analog -> allow.
query I
SELECT birdshot_authorize('bsess', 'SELECT main.t.c1 FROM main.t JOIN main.t2 ON main.t.c1 = main.t2.c1');
----
true

# Generated columns -> INFORMATION-FLOW semantics (bind-and-walk's natural model,
# user decision). The binder replaces a generated column with its generation
# expression, so bind-and-walk sees the SOURCE columns it reads, not the generated
# name. `c5` (= c1 + 1) derives ONLY from the allowed column c1, so reading c5
# reads only allowed data -> ALLOW. (`c5` is unambiguous: it exists only on main.t.)
# This is sound: a generated column is allowed iff all its source columns are
# allowed; no forbidden data can leak through it. The forbidden-source control
# (a generated column derived from c3) is in the bind-and-walk regression section.
query I
SELECT birdshot_authorize('bsess', 'SELECT c5 FROM main.t JOIN main.t2 ON main.t.c1 = main.t2.c1');
----
true

# S7: whoami() is allow-listed as quack node-identity introspection -> allow.
query I
SELECT birdshot_authorize('bsess', 'SELECT * FROM whoami()');
----
true

# ============================================================================
# bind-and-walk regression suite
#
# These pin the bind-and-walk extraction (which supersedes the parse-walk's
# table/column extraction). All run on the `bsess` session (user bob, role
# colrole): main.t read+write, columns restricted to {c1,c2}; main.t2 read+write,
# unconstrained. lake_catalog = 'memory'.
# ============================================================================

# ---- regression-suite fixtures + config -------------------------------------
# birdshot_commit_config() REPLACES the live snapshot with staging (it does not
# merge), exactly like the gateway's applySnapshot. So this section creates ALL
# its tables, then RE-STAGES the complete colrole config (the original grants +
# the regression-table grants/constraints) and commits ONCE. The `bsess` session
# (authenticated earlier) survives — sessions are kept separately from the
# swappable policy snapshot.

statement ok
CREATE TABLE main.st(c1 INT, c2 INT, c3 STRUCT(f INT, g INT), c4 STRUCT(mid STRUCT(deeper INT)));

statement ok
CREATE TABLE main.gt(c1 INT, c2 INT, c3 INT, g_ok INT GENERATED ALWAYS AS (c1 + 1), g_bad INT GENERATED ALWAYS AS (c3 + 1));

statement ok
CREATE TABLE main.ungranted(c1 INT);

# Re-stage the FULL colrole policy (original + regression tables) and commit once.
statement ok
SELECT birdshot_set_auth('', '', 'dev');

statement ok
SELECT birdshot_set_lake_catalog('memory');

statement ok
SELECT birdshot_add_role_grant('colrole', 'main.t', 'read');

statement ok
SELECT birdshot_add_role_grant('colrole', 'main.t', 'write');

statement ok
SELECT birdshot_add_role_grant('colrole', 'main.t2', 'read');

statement ok
SELECT birdshot_add_role_grant('colrole', 'main.t2', 'write');

statement ok
SELECT birdshot_add_role_grant('colrole', 'main.st', 'read');

statement ok
SELECT birdshot_add_role_grant('colrole', 'main.gt', 'read');

statement ok
SELECT birdshot_add_grant_constraint('colrole', 'main.t', 'c1,c2', '', '');

statement ok
SELECT birdshot_add_grant_constraint('colrole', 'main.st', 'c1', '', '');

statement ok
SELECT birdshot_add_grant_constraint('colrole', 'main.gt', 'c1,c2', '', '');

statement ok
SELECT birdshot_add_user_role('bob', 'colrole');

statement ok
SELECT birdshot_commit_config();

# ---- BS-STRUCT-1: dotted struct/nested-field access via bind-walk -----------
# The binder wraps a struct field access in struct_extract over a BoundColumnRef
# to the BASE column, so the field name is never a column ref and the base column
# is charged exactly. main.st is constrained to {c1}: a forbidden base column (c3)
# is caught; the allowed c1 passes; field idents (`f`,`g`,`deeper`) never leak.

# DENY: unparenthesized dotted access to a forbidden struct base column c3.
query I
SELECT birdshot_authorize('bsess', 'SELECT c3.f FROM main.st');
----
false

# DENY: qualified dotted access (alias) to forbidden c3.
query I
SELECT birdshot_authorize('bsess', 'SELECT s.c3.f FROM main.st s');
----
false

# DENY: deeply-nested forbidden struct base (c4 not in {c1}).
query I
SELECT birdshot_authorize('bsess', 'SELECT c4.mid.deeper FROM main.st');
----
false

# DENY: forbidden struct base read in WHERE.
query I
SELECT birdshot_authorize('bsess', 'SELECT c1 FROM main.st WHERE c3.g > 0');
----
false

# ALLOW: allowed base column; whole struct never touched.
query I
SELECT birdshot_authorize('bsess', 'SELECT c1 FROM main.st');
----
true

# ---- generated columns: information-flow model ------------------------------
# A generated column is replaced by its generation expr at bind, so bind-walk
# charges its SOURCE columns. Allowed-source -> allow; forbidden-source -> deny.
# (main.gt is created + granted + constrained to {c1,c2} in the fixtures above.)

# ALLOW: g_ok = c1 + 1 reads only the allowed column c1.
query I
SELECT birdshot_authorize('bsess', 'SELECT g_ok FROM main.gt');
----
true

# DENY: g_bad = c3 + 1 reads the forbidden column c3 (info-flow catch).
query I
SELECT birdshot_authorize('bsess', 'SELECT g_bad FROM main.gt');
----
false

# DENY control: direct forbidden c3.
query I
SELECT birdshot_authorize('bsess', 'SELECT c3 FROM main.gt');
----
false

# ---- WRITES / DDL: target table charged as a write -------------------------
# INSERT/UPDATE/DELETE bind to LogicalInsert/Update/Delete with the target table;
# CTAS to LogicalCreateTable. Each is charged as a write TableUse.

# INSERT into a write-granted table (well-formed arity) -> allow.
query I
SELECT birdshot_authorize('bsess', 'INSERT INTO main.t2 VALUES (1, 2, 3, 4)');
----
true

# INSERT into a table with NO write grant (main.st is read-only) -> deny.
query I
SELECT birdshot_authorize('bsess', 'INSERT INTO main.st VALUES (1, 2, NULL, NULL)');
----
false

# UPDATE a write-granted table -> allow.
query I
SELECT birdshot_authorize('bsess', 'UPDATE main.t2 SET c1 = 1 WHERE c2 = 2');
----
true

# DELETE on a write-granted table -> allow.
query I
SELECT birdshot_authorize('bsess', 'DELETE FROM main.t2 WHERE c1 = 1');
----
true

# DELETE on a table with no write grant (main.st) -> deny.
query I
SELECT birdshot_authorize('bsess', 'DELETE FROM main.st WHERE c1 = 1');
----
false

# CTAS (CREATE TABLE ... AS) is a CREATE/DDL statement class -> denied by the
# parse-walk PRE-FILTER (Layer 1) before bind-walk runs, same as any CREATE. DDL
# is never allowed on the agent path. (bind-walk's LogicalCreateTable handler is
# defensive: it would charge the new table as a write target if a future pre-filter
# ever admitted CTAS, but today CTAS never reaches Layer 2.)
query I
SELECT birdshot_authorize('bsess', 'CREATE TABLE main.t2 AS SELECT c1 FROM main.t2');
----
false

# UPDATE writing a forbidden column on a column-constrained table -> deny
# (column allow-lists are not action-scoped; c3 not in {c1,c2}).
query I
SELECT birdshot_authorize('bsess', 'UPDATE main.t SET c3 = 1 WHERE c1 = 0');
----
false

# ---- multi-statement batch: every statement is bound + walked ---------------
# A forbidden/ungranted read hidden after a benign statement denies the batch.
# (main.ungranted is created in the fixtures above; it has no grant.)

# A batch whose 2nd statement reads an ungranted table -> deny.
query I
SELECT birdshot_authorize('bsess', 'SELECT c1 FROM main.t2; SELECT c1 FROM main.ungranted');
----
false

# A batch of two granted reads -> allow.
query I
SELECT birdshot_authorize('bsess', 'SELECT c1 FROM main.t2; SELECT c1 FROM main.t');
----
true

# A batch whose 2nd statement reads a forbidden column on a constrained table -> deny.
query I
SELECT birdshot_authorize('bsess', 'SELECT c1 FROM main.t; SELECT c3 FROM main.t');
----
false

# ---- Q3: bare (unqualified) table resolves against the lake catalog ---------
# Form-A push-down sends `FROM <bare>` on a connection where USE lake did not
# carry. lake_catalog='memory' (the default here), so a bare ref resolves and the
# column constraint still applies.

# Bare table, allowed columns -> allow.
query I
SELECT birdshot_authorize('bsess', 'SELECT c1, c2 FROM t');
----
true

# Bare table, forbidden column -> deny.
query I
SELECT birdshot_authorize('bsess', 'SELECT c3 FROM t');
----
false

# Bare positional refs (#N, form-A) resolve to catalog ordinals -> c1,c2 allow.
query I
SELECT birdshot_authorize('bsess', 'SELECT #1, #2 FROM t');
----
true

# Bare positional ref to a forbidden ordinal (#3 = c3) -> deny.
query I
SELECT birdshot_authorize('bsess', 'SELECT #3 FROM t');
----
false

# ---- read_csv is blocked at the pre-filter (file/dynamic reader denylist) ----
# (enable_external_access=false is a Phase-3 gateway boot setting; the parse-walk
# pre-filter denies read_csv regardless, so this holds in-harness too.)
query I
SELECT birdshot_authorize('bsess', 'SELECT * FROM read_csv(''/etc/passwd'')');
----
false
