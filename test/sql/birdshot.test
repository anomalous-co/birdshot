SELECT birdshot_add_role_grant('kr', 'cs.*', 'create');
----
ok

query I
SELECT birdshot_add_role_grant('kr', '*', 'read');
----
ok

query I
SELECT birdshot_add_role_grant('kr', '__birdshot_grants', 'drop');
----
ok

# users + tokens + sessions
