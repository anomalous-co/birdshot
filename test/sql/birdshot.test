SELECT birdshot_add_service_token('wtok', 'wu');
----
ok

query I
SELECT birdshot_add_service_token('itok', 'iu');
----
ok

query I
SELECT birdshot_add_service_token('utok', 'uu');
----
ok

query I
SELECT birdshot_add_service_token('ftok', 'fu');
----
ok

query I
SELECT birdshot_add_service_token('rtok', 'ru');
----
ok

query I
SELECT birdshot_add_service_token('ktok', 'ku');
